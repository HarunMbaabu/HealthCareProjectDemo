{
  "version": 2,
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "web/index.html" },
    { "src": "/(health|predict|docs|openapi.json)", "dest": "api/main.py" }
  ]
}
